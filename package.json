{
  "name": "smart-factory-backend",
  "version": "1.0.0",
  "description": "Smart Factory Backend API built with Node.js and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/cluster.js",
    "start:single": "node dist/server.js",
    "dev": "nodemon",
    "dev:cluster": "ts-node src/cluster.ts",
    "scheduler": "ts-node src/infra/jobs/scheduler.ts",
    "scheduler:prod": "node dist/infra/jobs/scheduler.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "seed": "ts-node ./db/seeds/seed.ts",
    "recreate-task-indexes": "ts-node ./db/utils/recreate_task_indexes.ts",
    "recreate-all-indexes": "ts-node ./db/utils/recreate_all_indexes.ts",
    "reset-collections": "ts-node ./db/utils/resetCollections.ts",
    "test": "jest --config ./jest.config.js",
    "generate:module": "ts-node ./scripts/generate-module.ts"
  },
  "keywords": [
    "smart-factory",
    "backend",
    "api",
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jest": "^29.5.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.1",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/exceljs": "^0.5.3",
    "@types/multer": "^2.0.0",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.18.1",
    "mqtt": "^5.14.1",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "redis": "^5.10.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  }
}
